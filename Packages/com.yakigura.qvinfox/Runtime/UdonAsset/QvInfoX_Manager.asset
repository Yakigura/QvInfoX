      Data: 110|UnityEngine.TooltipAttribute, UnityEngine.CoreModule
    - Name: tooltip
      Entry: 1
      Data: "VRChat \u306E World Space UI \u306F\u30C7\u30B9\u30AF\u30C8\u30C3\u30D7\u3060\u3068\u753B\u9762\u4E2D\u592E\u306E\u30AF\u30ED\u30B9\u30D8\u30A2\u3067\u3057\u304B\u72D9\u3048\u305A\u3001\u5C0F\u3055\u3044\u30DC\u30BF\u30F3\u3092\u6B63\u78BA\u306B\u30AF\u30EA\u30C3\u30AF\u3059\u308B\u306E\u306F\u975E\u73FE\u5B9F\u7684
        (QvKeep \u540C\u69D8\u306E\u65E2\u77E5\u306E\u5236\u7D04)\u3002\u305D\u306E\u305F\u3081
        Unity \u6A19\u6E96\u306E UI \u30AF\u30EA\u30C3\u30AF\u7D4C\u8DEF\u306B\u306F\u983C\u3089\u305A\u3001\u982D\u306E\u5411\u304D\u306B\u98DB\u3070\u3057\u305F\u30EC\u30A4\u3068\u5404\u8981\u7D20\u306E
        RectTransform \u3092\u76F4\u63A5\u7A81\u304D\u5408\u308F\u305B\u3066\u5224\u5B9A\u3059\u308B\u3002"
